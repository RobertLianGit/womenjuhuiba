.panel {
    margin-top: 24rpx;
    padding: 24rpx;
    background: #FFFFFF;
}

.panel-title {
    display: block;
    font-size: 32rpx;
    font-weight: 900;
    line-height: 1.3;
}

/* 预览 */
.preview {
    margin-top: 24rpx;
    padding: 22rpx;
    border: 4rpx dashed #0A0A0A;
    background: #FFF9B2;
}

.preview-kicker {
    display: block;
    color: #5C5C3D;
    font-size: 20rpx;
    font-weight: 700;
    letter-spacing: 1rpx;
}

.preview-title {
    display: block;
    margin-top: 6rpx;
    font-size: 34rpx;
    font-weight: 900;
}

.preview-facts {
    display: flex;
    margin-top: 12rpx;
    flex-wrap: wrap;
}

.preview-fact {
    margin: 0 12rpx 8rpx 0;
    padding: 6rpx 14rpx;
    border: 3rpx solid #0A0A0A;
    background: #FFFFFF;
    font-size: 22rpx;
    font-weight: 700;
}

.preview-ask {
    display: block;
    margin-top: 8rpx;
    font-size: 26rpx;
    font-weight: 800;
}

.tip {
    display: block;
    margin-top: 14rpx;
    color: #5C5C3D;
    font-size: 21rpx;
    line-height: 1.6;
    text-align: left;
}

/* 已发布 */
.done {
    margin-top: 24rpx;
    padding: 22rpx;
    background: #DDF7E6;
}

.done-title {
    display: block;
    font-size: 28rpx;
    font-weight: 900;
}

.done-sub {
    display: block;
    margin-top: 6rpx;
    color: #2A4A32;
    font-size: 22rpx;
    line-height: 1.5;
}

/* 环节 */
.scene-block {
    margin-top: 36rpx;
    padding-top: 22rpx;
    border-top: 4rpx solid #0A0A0A;
}

.scene-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.scene-title {
    font-size: 28rpx;
    font-weight: 900;
}

.scene-add {
    padding: 8rpx 16rpx;
    border: 3rpx solid #0A0A0A;
    background: #FFF34D;
    font-size: 22rpx;
    font-weight: 700;
}

.scene-tip {
    display: block;
    margin-top: 10rpx;
    color: #5C5C3D;
    font-size: 21rpx;
    line-height: 1.6;
}

.scene {
    display: flex;
    margin-top: 14rpx;
    padding: 16rpx 18rpx;
    align-items: center;
    border: 3rpx solid #0A0A0A;
    background: #FFFFFF;
}

.scene-main {
    flex: 1;
    min-width: 0;
}

.scene-name {
    display: block;
    font-size: 26rpx;
    font-weight: 800;
}

.scene-meta {
    display: block;
    color: #5C5C3D;
    font-size: 21rpx;
}

.scene-ops {
    display: flex;
    flex-shrink: 0;
}

.scene-op {
    margin-left: 12rpx;
    padding: 8rpx 14rpx;
    border: 3rpx solid #0A0A0A;
    font-size: 21rpx;
    font-weight: 700;
}

.scene-op-del {
    border-color: #D7263D;
    color: #D7263D;
}

.scene-empty {
    margin-top: 14rpx;
    padding: 20rpx;
    border: 3rpx dashed #C9C4A0;
    color: #6B6B4A;
    font-size: 22rpx;
    text-align: center;
}
