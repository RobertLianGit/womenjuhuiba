<view class="nb-page">
    <view class="idbar" bindtap="openProfile">
        <image wx:if="{{identity.avatar}}" class="idbar-avatar" src="{{identity.avatar}}" mode="aspectFill" />
        <view wx:else class="idbar-avatar idbar-avatar-ph">{{identity.initial || '?'}}</view>
        <view class="idbar-main">
            <text class="idbar-name">{{identity.name || '先点这里设个称呼'}}</text>
            <text class="idbar-tag" catchtap="recheckIdentity">{{identity.wechat ? '微信身份 · 换手机也不丢' : '本机身份 · 点这里重试用微信身份'}}</text>
            <text wx:if="{{idHint}}" class="idbar-hint">微信登录没接通：{{idHint}}</text>
        </view>
        <text class="idbar-edit">{{identity.name ? '改' : '去设置'}}</text>
    </view>

    <view class="hero">
        <view class="hero-tag">点开链接就能加入 · 你审批</view>
        <view class="hero-line">
            <text class="hero-title">报名助手</text>
            <text class="hero-title-brand">LBB</text>
        </view>
        <text class="hero-desc">把「来不来」的人数统计清楚，省得一个个问</text>
    </view>

    <button class="nb-btn nb-btn-primary hero-btn" bindtap="openCreate">＋ 发起一场聚会</button>

    <view class="howto nb-card-flat">
        <view class="howto-item">
            <text class="howto-num">A</text>
            <view class="howto-body">
                <text class="howto-title">已经定好了</text>
                <text class="howto-text">填时间地点，发给大家确认参加，直接出名单。</text>
            </view>
        </view>
        <view class="howto-item">
            <text class="howto-num">B</text>
            <view class="howto-body">
                <text class="howto-title">还没定，先问问</text>
                <text class="howto-text">先收意愿，需要时投个票，定了再让大家确认。</text>
            </view>
        </view>
    </view>

    <view class="tabs">
        <view class="tab {{tab === 'created' ? 'tab-on' : ''}}" data-tab="created" bindtap="switchTab">我发起的（{{createdList.length}}）</view>
        <view class="tab {{tab === 'joined' ? 'tab-on' : ''}}" data-tab="joined" bindtap="switchTab">我参与的（{{joinedList.length}}）</view>
    </view>

    <view class="nb-state" wx:if="{{loading}}">
        <text class="nb-state-icon">…</text>
        <text class="nb-state-text">正在加载</text>
    </view>

    <view class="nb-state" wx:elif="{{errorMsg}}">
        <text class="nb-state-icon">!</text>
        <text class="nb-state-text">{{errorMsg}}</text>
        <button class="nb-btn nb-btn-ghost state-btn" bindtap="retry">重新加载</button>
    </view>

    <block wx:else>
        <block wx:if="{{tab === 'created'}}">
            <view class="card nb-card" wx:for="{{createdList}}" wx:key="id" data-id="{{item.id}}" bindtap="goActivity">
                <view class="card-top">
                    <text class="card-title">{{item.title}}</text>
                    <view class="card-chip" style="background:{{item.phaseBg}};color:{{item.phaseFg}}">{{item.phaseLabel}}</view>
                </view>
                <view class="card-meta">
                    <text class="card-meta-t">{{item.timeText || '时间待定'}}</text>
                    <text class="card-meta-t" wx:if="{{item.place}}">· {{item.place}}</text>
                </view>
                <view class="card-foot">
                    <text class="card-state">{{item.line}}</text>
                    <text class="card-go">看进展 →</text>
                </view>
            </view>
            <view class="nb-state" wx:if="{{createdList.length === 0}}">
                <text class="nb-state-icon">＋</text>
                <text class="nb-state-text">还没有你发起的聚会\n点上面的按钮开一场</text>
            </view>
        </block>

        <block wx:else>
            <view class="card nb-card" wx:for="{{joinedList}}" wx:key="id" data-id="{{item.id}}" bindtap="goActivity">
                <view class="card-top">
                    <text class="card-title">{{item.title}}</text>
                    <view class="card-chip" style="background:{{item.phaseBg}};color:{{item.phaseFg}}">{{item.phaseLabel}}</view>
                </view>
                <view class="card-meta">
                    <text class="card-meta-t">{{item.creatorName}} 发起</text>
                    <text class="card-meta-t" wx:if="{{item.timeText}}">· {{item.timeText}}</text>
                </view>
                <view class="card-foot">
                    <text class="card-state {{item.needMe ? 'card-state-hot' : ''}}">{{item.line}}</text>
                    <text class="card-go">{{item.needMe ? '该你了 →' : '看看 →'}}</text>
                </view>
            </view>
            <view class="nb-state" wx:if="{{joinedList.length === 0}}">
                <text class="nb-state-icon">#</text>
                <text class="nb-state-text">还没有你参与的聚会\n朋友把邀请发给你，点开就能进</text>
            </view>
        </block>
    </block>

    <view class="footer">
        <text class="footer-text">加入靠微信身份，不用口令。你自己发的邀请，朋友点开直接进；别人转出去的，需要你点一下通过。</text>
    </view>
</view>

<!-- 称呼与头像 -->
<view class="nb-mask" wx:if="{{showProfile}}" bindtap="closeProfile"></view>
<view class="nb-sheet" wx:if="{{showProfile}}">
    <view class="nb-sheet-head">
        <text class="nb-sheet-title">让朋友认出你</text>
        <text class="nb-close" bindtap="closeProfile">×</text>
    </view>

    <view class="profile-row">
        <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
            <image wx:if="{{profileAvatar}}" class="avatar-img" src="{{profileAvatar}}" mode="aspectFill" />
            <view wx:else class="avatar-ph">选头像</view>
        </button>
        <view class="profile-main">
            <text class="nb-field-label">称呼</text>
            <input class="nb-input" type="nickname" value="{{profileName}}" bindinput="onProfileNameInput" bindblur="onProfileNameInput" placeholder="点这里，可一键填微信昵称" placeholder-class="nb-placeholder" maxlength="20" />
        </view>
    </view>

    <view class="nb-note">这个称呼会带到投票和报名里，以后不用再填。微信不会自动把昵称给小程序，所以第一次填一下。</view>

    <button class="nb-btn nb-btn-primary submit" bindtap="saveProfile">保存</button>
</view>

<!-- 创建 -->
<view class="nb-mask" wx:if="{{showCreate}}" bindtap="closeCreate"></view>
<view class="nb-sheet" wx:if="{{showCreate}}">
    <view class="nb-sheet-head">
        <text class="nb-sheet-title">发起聚会</text>
        <text class="nb-close" bindtap="closeCreate">×</text>
    </view>

    <text class="pick-title">这次是哪一种？</text>

    <view class="mode {{mode === 'fixed' ? 'mode-on' : ''}}" data-mode="fixed" bindtap="chooseMode">
        <view class="mode-mark">{{mode === 'fixed' ? '✓' : ''}}</view>
        <view class="mode-body">
            <text class="mode-title">已经定好了，叫大家来</text>
            <text class="mode-desc">填时间地点，朋友直接确认参加，不用投票。</text>
        </view>
    </view>

    <view class="mode {{mode === 'flow' ? 'mode-on' : ''}}" data-mode="flow" bindtap="chooseMode">
        <view class="mode-mark">{{mode === 'flow' ? '✓' : ''}}</view>
        <view class="mode-body">
            <text class="mode-title">还没定，先问问大家</text>
            <text class="mode-desc">先收意愿，需要就投票，定了再公布安排。</text>
        </view>
    </view>

    <block wx:if="{{mode === 'fixed'}}">
        <view class="nb-field">
            <text class="nb-field-label">活动名称 *</text>
            <input class="nb-input" value="{{form.title}}" data-field="title" bindinput="onFormInput" placeholder="比如：周六晚饭" placeholder-class="nb-placeholder" maxlength="40" />
        </view>
        <view class="nb-field">
            <text class="nb-field-label">时间 *</text>
            <input class="nb-input" value="{{form.timeText}}" data-field="timeText" bindinput="onFormInput" placeholder="比如：11 月 21 日 18:30" placeholder-class="nb-placeholder" maxlength="40" />
        </view>
        <view class="nb-field">
            <text class="nb-field-label">地点</text>
            <input class="nb-input" value="{{form.place}}" data-field="place" bindinput="onFormInput" placeholder="比如：城南那家小馆" placeholder-class="nb-placeholder" maxlength="60" />
        </view>
        <view class="nb-field">
            <text class="nb-field-label">费用说明</text>
            <input class="nb-input" value="{{form.costNote}}" data-field="costNote" bindinput="onFormInput" placeholder="比如：人均 80 左右，AA" placeholder-class="nb-placeholder" maxlength="60" />
        </view>
        <view class="nb-field">
            <text class="nb-field-label">补充说明</text>
            <textarea class="nb-textarea" value="{{form.extraNote}}" data-field="extraNote" bindinput="onFormInput" placeholder="注意事项、带什么、几点前散……" placeholder-class="nb-placeholder" maxlength="120" />
        </view>
    </block>

    <block wx:elif="{{mode === 'flow'}}">
        <view class="nb-field">
            <text class="nb-field-label">这次想约什么 *</text>
            <input class="nb-input" value="{{form.title}}" data-field="title" bindinput="onFormInput" placeholder="比如：周末聚一聚" placeholder-class="nb-placeholder" maxlength="40" />
        </view>
        <view class="nb-field">
            <text class="nb-field-label">大致想法</text>
            <textarea class="nb-textarea" value="{{form.description}}" data-field="description" bindinput="onFormInput" placeholder="想做什么、大概什么时候、有没有预算……" placeholder-class="nb-placeholder" maxlength="120" />
        </view>
        <view class="nb-field">
            <text class="nb-field-label">大致时间</text>
            <input class="nb-input" value="{{form.timeText}}" data-field="timeText" bindinput="onFormInput" placeholder="比如：这个周末，具体再商量" placeholder-class="nb-placeholder" maxlength="40" />
        </view>
        <view class="nb-note">朋友进来先表个态（有兴趣 / 看安排再定 / 不参加），不算正式报名。</view>
    </block>

    <view class="nb-note nb-note-error" wx:if="{{createError}}">{{createError}}</view>

    <button class="nb-btn nb-btn-primary submit" bindtap="submitCreate" loading="{{creating}}" disabled="{{creating}}">
        {{creating ? '正在创建…' : '创建并分享'}}
    </button>
</view>

<!-- 创建成功 -->
<view class="nb-mask" wx:if="{{result}}" bindtap="closeResult"></view>
<view class="nb-sheet" wx:if="{{result}}">
    <view class="nb-sheet-head">
        <text class="nb-sheet-title">创建好了</text>
        <text class="nb-close" bindtap="closeResult">×</text>
    </view>

    <text class="result-name">{{result.title}}</text>
    <text class="result-sub">{{result.mode === 'fixed' ? '把邀请发出去，大家点开就能确认参加。' : '把邀请发出去，先问问大家有没有兴趣。'}}</text>

    <button class="nb-btn nb-btn-primary submit" open-type="share">分享给朋友</button>
    <button class="nb-btn nb-btn-ghost submit" bindtap="copyShareInfo">复制文字版</button>
    <button class="nb-btn submit" bindtap="enterCreated">进入活动 →</button>

    <text class="result-tip">你亲自发的邀请，朋友点开直接进，不用你审批。</text>
</view>
