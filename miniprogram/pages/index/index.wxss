.hero {
    padding: 8rpx 0 0;
}

.hero-tag {
    display: inline-block;
    padding: 6rpx 16rpx;
    border: 4rpx solid #0A0A0A;
    background: #FFFFFF;
    font-size: 22rpx;
    font-weight: 700;
}

.hero-line {
    display: flex;
    align-items: flex-end;
    flex-wrap: wrap;
    margin-top: 22rpx;
}

.hero-title {
    display: block;
    font-size: 68rpx;
    font-weight: 900;
    letter-spacing: -2rpx;
    line-height: 1.1;
}

.hero-title-brand {
    display: block;
    margin-left: 10rpx;
    margin-bottom: 6rpx;
    padding: 2rpx 12rpx;
    background: #0A0A0A;
    color: #FFF34D;
    font-size: 44rpx;
    font-weight: 900;
    letter-spacing: 2rpx;
    line-height: 1.2;
}

.hero-desc {
    display: block;
    margin-top: 16rpx;
    font-size: 26rpx;
    line-height: 1.6;
}

.hero-btn {
    width: 100%;
    height: 104rpx;
    margin-top: 30rpx;
    font-size: 34rpx;
}

.howto {
    margin-top: 30rpx;
    padding: 8rpx 24rpx;
}

.howto-item {
    display: flex;
    padding: 20rpx 0;
    align-items: flex-start;
    border-bottom: 3rpx dashed #C9C4A0;
}

.howto-item:last-child {
    border-bottom: none;
}

.howto-num {
    width: 52rpx;
    height: 52rpx;
    flex: none;
    border: 3rpx solid #0A0A0A;
    background: #FF4DB8;
    font-size: 24rpx;
    font-weight: 900;
    line-height: 46rpx;
    text-align: center;
}

.howto-body {
    flex: 1;
    min-width: 0;
    padding-left: 18rpx;
}

.howto-title {
    display: block;
    font-size: 27rpx;
    font-weight: 800;
}

.howto-text {
    display: block;
    margin-top: 4rpx;
    color: #4A4A2F;
    font-size: 23rpx;
    line-height: 1.5;
}

.tabs {
    display: flex;
    margin: 36rpx 0 24rpx;
    border: 4rpx solid #0A0A0A;
    background: #FFFFFF;
}

.tab {
    flex: 1;
    padding: 22rpx 0;
    font-size: 26rpx;
    font-weight: 700;
    text-align: center;
}

.tab-on {
    background: #0A0A0A;
    color: #FFFFFF;
}

.card {
    margin-bottom: 24rpx;
    padding: 24rpx;
}

.card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
}

.card-title {
    flex: 1;
    padding-right: 16rpx;
    font-size: 33rpx;
    font-weight: 800;
    line-height: 1.35;
}

.card-chip {
    flex: none;
    padding: 6rpx 14rpx;
    border: 3rpx solid #0A0A0A;
    font-size: 20rpx;
    font-weight: 700;
}

.card-meta {
    display: flex;
    margin-top: 14rpx;
    align-items: center;
    flex-wrap: wrap;
}

.card-meta-t {
    margin-right: 10rpx;
    color: #5C5C3D;
    font-size: 23rpx;
}

.card-foot {
    display: flex;
    margin-top: 18rpx;
    padding-top: 14rpx;
    align-items: center;
    border-top: 3rpx dashed #C9C4A0;
    justify-content: space-between;
}

.card-state {
    font-size: 24rpx;
    font-weight: 800;
}

.card-state-hot {
    color: #C2185B;
}

.card-go {
    color: #5C5C3D;
    font-size: 22rpx;
    font-weight: 700;
}

.state-btn {
    margin-top: 24rpx;
}

.footer {
    margin-top: 40rpx;
    padding: 22rpx;
    border: 3rpx dashed #0A0A0A;
}

.footer-text {
    color: #4A4A2F;
    font-size: 22rpx;
    line-height: 1.7;
}

/* ===== 创建方式选择 ===== */
.pick-title {
    display: block;
    margin-top: 22rpx;
    font-size: 24rpx;
    font-weight: 800;
}

.mode {
    display: flex;
    margin-top: 16rpx;
    padding: 20rpx;
    align-items: flex-start;
    border: 4rpx solid #0A0A0A;
    background: #FFFDF0;
}

.mode-on {
    background: #FFF34D;
    box-shadow: 6rpx 6rpx 0 #0A0A0A;
}

.mode-mark {
    width: 44rpx;
    height: 44rpx;
    flex-shrink: 0;
    border: 3rpx solid #0A0A0A;
    background: #FFFFFF;
    font-size: 26rpx;
    font-weight: 900;
    line-height: 42rpx;
    text-align: center;
}

.mode-body {
    flex: 1;
    min-width: 0;
    padding-left: 16rpx;
}

.mode-title {
    display: block;
    font-size: 28rpx;
    font-weight: 800;
}

.mode-desc {
    display: block;
    margin-top: 4rpx;
    color: #4A4A2F;
    font-size: 22rpx;
    line-height: 1.5;
}

.submit {
    margin-top: 28rpx;
}

/* ===== 创建成功 ===== */
.result-name {
    display: block;
    margin-top: 24rpx;
    font-size: 36rpx;
    font-weight: 800;
}

.result-sub {
    display: block;
    margin-top: 10rpx;
    color: #5C5C3D;
    font-size: 24rpx;
    line-height: 1.6;
}

.result-tip {
    display: block;
    margin-top: 16rpx;
    color: #6B6B4A;
    font-size: 21rpx;
    line-height: 1.5;
    text-align: center;
}
