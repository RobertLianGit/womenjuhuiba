.state-btn {
    margin-top: 24rpx;
}

/* ===== 设置投票 ===== */
.setup {
    margin-top: 24rpx;
    padding: 24rpx;
    background: #FFFFFF;
}

.setup-title {
    display: block;
    font-size: 32rpx;
    font-weight: 900;
}

.setup-tip {
    display: block;
    margin-top: 6rpx;
    color: #5C5C3D;
    font-size: 23rpx;
    line-height: 1.5;
}

.rule-row {
    display: flex;
    align-items: center;
}

.rule-opt {
    margin-right: 14rpx;
    padding: 14rpx 28rpx;
    border: 4rpx solid #0A0A0A;
    background: #FFFFFF;
    font-size: 26rpx;
    font-weight: 800;
}

.rule-on {
    background: #FFF34D;
    box-shadow: 4rpx 4rpx 0 #0A0A0A;
}

.rule-input {
    width: 90rpx;
    height: 70rpx;
    border: 4rpx solid #0A0A0A;
    background: #F5F0D0;
    font-size: 28rpx;
    font-weight: 800;
    text-align: center;
}

.rule-unit {
    margin-left: 10rpx;
    font-size: 24rpx;
    font-weight: 700;
}

.opt-row {
    display: flex;
    margin-bottom: 14rpx;
    align-items: center;
}

.opt-index {
    width: 44rpx;
    flex-shrink: 0;
    font-size: 24rpx;
    font-weight: 900;
}

.opt-input {
    flex: 1;
    min-width: 0;
}

.opt-del {
    margin-left: 12rpx;
    padding: 12rpx 16rpx;
    border: 3rpx solid #D7263D;
    color: #D7263D;
    font-size: 22rpx;
    font-weight: 700;
}

.opt-add {
    margin-top: 6rpx;
    padding: 16rpx;
    border: 3rpx dashed #0A0A0A;
    font-size: 24rpx;
    font-weight: 700;
    text-align: center;
}

.import {
    margin-top: 22rpx;
    padding: 18rpx;
    border: 3rpx dashed #0A0A0A;
    background: #FFF9B2;
}

.import-title {
    display: block;
    font-size: 22rpx;
    font-weight: 700;
}

.import-list {
    display: flex;
    margin-top: 10rpx;
    flex-wrap: wrap;
}

.import-chip {
    margin: 0 12rpx 12rpx 0;
    padding: 10rpx 18rpx;
    border: 3rpx solid #0A0A0A;
    background: #FFFFFF;
    font-size: 23rpx;
}

.deadline-row {
    display: flex;
    align-items: center;
}

.deadline-pick {
    margin-right: 14rpx;
    padding: 16rpx 22rpx;
    border: 4rpx solid #0A0A0A;
    background: #F5F0D0;
    font-size: 25rpx;
    font-weight: 700;
}

.field-tip {
    display: block;
    margin-top: 10rpx;
    color: #6B6B4A;
    font-size: 21rpx;
}

/* ===== 投票题面 ===== */
.q {
    margin-top: 24rpx;
    padding: 24rpx;
    background: #FFFFFF;
}

.q-title {
    display: block;
    font-size: 40rpx;
    font-weight: 900;
    line-height: 1.3;
}

.q-meta {
    display: flex;
    margin-top: 14rpx;
    flex-wrap: wrap;
}

.q-meta .nb-tag {
    margin: 0 12rpx 8rpx 0;
}

/* 我的状态 */
.mine {
    margin-top: 20rpx;
    padding: 20rpx 22rpx;
    border: 4rpx solid #0A0A0A;
    background: #DDF7E6;
}

.mine-muted {
    background: #FFFFFF;
}

.mine-title {
    display: block;
    font-size: 28rpx;
    font-weight: 900;
}

.mine-sub {
    display: block;
    margin-top: 4rpx;
    color: #4A4A2F;
    font-size: 23rpx;
    line-height: 1.5;
}

/* 选项 */
.opt {
    display: flex;
    margin-top: 16rpx;
    padding: 20rpx;
    align-items: center;
    border: 4rpx solid #0A0A0A;
    background: #FFFFFF;
}

.opt-on {
    background: #FFF34D;
    box-shadow: 6rpx 6rpx 0 #0A0A0A;
}

.opt-locked {
    opacity: 0.92;
}

.opt-mark {
    width: 46rpx;
    height: 46rpx;
    flex-shrink: 0;
    border: 3rpx solid #0A0A0A;
    background: #FFFFFF;
    font-size: 28rpx;
    font-weight: 900;
    line-height: 44rpx;
    text-align: center;
}

.opt-body {
    flex: 1;
    min-width: 0;
    padding: 0 16rpx;
}

.opt-name {
    display: block;
    font-size: 30rpx;
    font-weight: 800;
    line-height: 1.35;
}

.opt-meta {
    display: block;
    margin-top: 2rpx;
    color: #5C5C3D;
    font-size: 21rpx;
}

.bar {
    height: 16rpx;
    margin-top: 10rpx;
    border: 3rpx solid #0A0A0A;
    background: #F5F0D0;
}

.bar-fill {
    height: 100%;
    background: #22C55E;
}

.opt-votes {
    flex-shrink: 0;
    text-align: center;
}

.opt-num {
    display: block;
    font-size: 34rpx;
    font-weight: 900;
    line-height: 1.1;
}

.opt-unit {
    display: block;
    color: #5C5C3D;
    font-size: 19rpx;
}

.dirty-tip {
    margin-top: 18rpx;
    padding: 12rpx 16rpx;
    border: 3rpx solid #0A0A0A;
    background: #FFF9B2;
    font-size: 23rpx;
    font-weight: 700;
}

.propose-entry {
    display: flex;
    margin-top: 26rpx;
    padding: 20rpx 22rpx;
    align-items: center;
    border: 3rpx dashed #0A0A0A;
    justify-content: space-between;
}

.propose-text {
    font-size: 24rpx;
    font-weight: 700;
}

.propose-arrow {
    font-size: 30rpx;
    font-weight: 900;
}

/* 组织者 */
.org {
    margin-top: 30rpx;
    padding: 22rpx;
    border: 4rpx solid #0A0A0A;
    background: #0A0A0A;
    box-shadow: 10rpx 10rpx 0 #FF4DB8;
    color: #FFFFFF;
}

.org-title {
    display: block;
    color: #FFF34D;
    font-size: 26rpx;
    font-weight: 900;
}

.org-tip {
    display: block;
    margin-top: 8rpx;
    color: #D8D8C0;
    font-size: 22rpx;
    line-height: 1.5;
}

.org-btn {
    width: auto;
    height: 88rpx;
    margin-top: 18rpx;
    font-size: 27rpx;
}
